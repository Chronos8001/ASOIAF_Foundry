<div class="asoiaf-sheet item-sheet">
  <header class="sheet-header item-header">
    <img class="portrait small" src="{{item.img}}" alt="" data-action="editImage">
    <div class="header-main">
      <input class="actor-name" type="text" name="name" value="{{item.name}}">
      <span class="type-label">{{typeLabel}}</span>
    </div>
  </header>

  <section class="item-body">
    {{#if isType.weapon}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Weapon.specialty"}}<select name="system.specialty">{{selectOptions specialtyOptions selected=system.specialty localize=true}}</select></label>
        <label>{{localize "ASOIAF.Weapon.training"}} (B)<input type="number" min="0" name="system.training" value="{{system.training}}"></label>
        <label>{{localize "ASOIAF.Weapon.damageAbility"}}<select name="system.damageAbility">{{selectOptions damageAbilityOptions selected=system.damageAbility localize=true}}</select></label>
        <label>{{localize "ASOIAF.Weapon.damageMod"}}<input type="number" name="system.damageMod" value="{{system.damageMod}}"></label>
        <label>{{localize "ASOIAF.Weapon.defensive"}}<input type="number" min="0" name="system.defensive" value="{{system.defensive}}"></label>
        <label>{{localize "ASOIAF.Weapon.piercing"}}<input type="number" min="0" name="system.piercing" value="{{system.piercing}}"></label>
        <label>{{localize "ASOIAF.Weapon.grade"}}<select name="system.grade">{{selectOptions gradeOptions selected=system.grade localize=true}}</select></label>
        <label>{{localize "ASOIAF.Combat.bulk"}}<input type="number" min="0" name="system.bulk" value="{{system.bulk}}"></label>
        <label>{{localize "ASOIAF.Common.cost"}}<input type="text" name="system.cost" value="{{system.cost}}"></label>
        <label>{{localize "ASOIAF.Inventory.weight"}} (kg)<input type="number" min="0" step="0.1" name="system.weight" value="{{system.weight}}"></label>
        <label class="checkbox"><input type="checkbox" name="system.equipped" {{checked system.equipped}}> {{localize "ASOIAF.Common.equipped"}}</label>
      </div>
      <label class="block">{{localize "ASOIAF.Weapon.qualities"}}<input type="text" name="system.qualities" value="{{system.qualities}}"></label>
    {{/if}}

    {{#if isType.armor}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Armor.rating"}}<input type="number" min="0" name="system.rating" value="{{system.rating}}"></label>
        <label>{{localize "ASOIAF.Armor.penalty"}}<input type="number" max="0" name="system.penalty" value="{{system.penalty}}"></label>
        <label>{{localize "ASOIAF.Combat.bulk"}}<input type="number" min="0" name="system.bulk" value="{{system.bulk}}"></label>
        <label>{{localize "ASOIAF.Common.cost"}}<input type="text" name="system.cost" value="{{system.cost}}"></label>
        <label>{{localize "ASOIAF.Inventory.weight"}} (kg)<input type="number" min="0" step="0.1" name="system.weight" value="{{system.weight}}"></label>
        <label class="checkbox"><input type="checkbox" name="system.equipped" {{checked system.equipped}}> {{localize "ASOIAF.Common.equipped"}}</label>
      </div>
    {{/if}}

    {{#if isType.equipment}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Inventory.category"}}<select name="system.category">{{selectOptions categoryOptions selected=system.category localize=true}}</select></label>
        <label>{{localize "ASOIAF.Common.quantity"}}<input type="number" min="0" name="system.quantity" value="{{system.quantity}}"></label>
        <label>{{localize "ASOIAF.Combat.bulk"}}<input type="number" min="0" name="system.bulk" value="{{system.bulk}}"></label>
        <label>{{localize "ASOIAF.Common.cost"}}<input type="text" name="system.cost" value="{{system.cost}}"></label>
        <label>{{localize "ASOIAF.Inventory.weight"}} (kg)<input type="number" min="0" step="0.1" name="system.weight" value="{{system.weight}}"></label>
        <label class="checkbox"><input type="checkbox" name="system.equipped" {{checked system.equipped}}> {{localize "ASOIAF.Common.carried"}}</label>
      </div>
    {{/if}}

    {{#if isType.poison}}
      {{#if system.active}}<p class="hint warning">{{localize "ASOIAF.Poison.activeHint"}}</p>{{/if}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Poison.delivery"}}<input type="text" name="system.delivery" value="{{system.delivery}}" data-tooltip="ASOIAF.Poison.deliveryHint"></label>
        <label>{{localize "ASOIAF.Poison.virulence"}}<input type="number" min="0" name="system.virulence" value="{{system.virulence}}"></label>
        <label>{{localize "ASOIAF.Poison.diagnosis"}}<input type="number" min="0" name="system.diagnosis" value="{{system.diagnosis}}"></label>
        <label data-tooltip="ASOIAF.Poison.resistHint">{{localize "ASOIAF.Poison.resistBonus"}}<input type="number" name="system.resistBonus" value="{{system.resistBonus}}"></label>
        <label data-tooltip="ASOIAF.Poison.cureHint">{{localize "ASOIAF.Poison.cureDegrees"}}<input type="number" min="0" name="system.cureDegrees" value="{{system.cureDegrees}}"></label>
        <label>{{localize "ASOIAF.Poison.alcohol"}}<select name="system.alcohol">{{selectOptions alcoholOptions selected=system.alcohol localize=true}}</select></label>
        <label>{{localize "ASOIAF.Common.quantity"}}<input type="number" min="0" name="system.quantity" value="{{system.quantity}}"></label>
        <label>{{localize "ASOIAF.Common.cost"}}<input type="text" name="system.cost" value="{{system.cost}}"></label>
        <label>{{localize "ASOIAF.Inventory.weight"}} (kg)<input type="number" min="0" step="0.1" name="system.weight" value="{{system.weight}}"></label>
      </div>
      <h4>{{localize "ASOIAF.Poison.stages"}}</h4>
      <ol class="poison-stages">
        {{#each poisonStages}}
          <li><strong>{{title}}</strong> — {{schedule}}
            <ul>{{#each effects}}<li>{{this}}</li>{{/each}}</ul>
            {{#if follow}}<div class="hint">{{follow}}</div>{{/if}}
          </li>
        {{/each}}
      </ol>
      {{#if poisonThresholds.length}}<p><strong>{{localize "ASOIAF.Poison.thresholds"}} :</strong> {{poisonThresholds}}</p>{{/if}}
      <p><strong>{{localize "ASOIAF.Poison.recoveryTitle"}} :</strong> {{poisonRecovery}}</p>
      {{#if editable}}
        <details class="modifier-help">
          <summary>{{localize "ASOIAF.Poison.advanced"}}</summary>
          <p class="hint">{{localize "ASOIAF.Poison.advancedHint"}}</p>
          <label class="block">{{localize "ASOIAF.Poison.stages"}}<textarea data-json="stages" rows="10" class="code">{{poisonJson.stages}}</textarea></label>
          <label class="block">{{localize "ASOIAF.Poison.thresholds"}}<textarea data-json="thresholds" rows="3" class="code">{{poisonJson.thresholds}}</textarea></label>
          <label class="block">{{localize "ASOIAF.Poison.recoveryTitle"}}<textarea data-json="recovery" rows="3" class="code">{{poisonJson.recovery}}</textarea></label>
        </details>
      {{/if}}
    {{/if}}

    {{#if isType.benefit}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Benefit.category"}}<input type="text" name="system.category" value="{{system.category}}"></label>
        <label>{{localize "ASOIAF.Benefit.destinyCost"}}<input type="number" min="0" name="system.destinyCost" value="{{system.destinyCost}}"></label>
      </div>
      <label class="block">{{localize "ASOIAF.Benefit.requirements"}}<input type="text" name="system.requirements" value="{{system.requirements}}"></label>
      <label class="checkbox"><input type="checkbox" name="system.repeatable" {{checked system.repeatable}}> {{localize "ASOIAF.Benefit.repeatable"}}</label>
    {{/if}}

    {{#if isType.drawback}}
      <label class="block">{{localize "ASOIAF.Benefit.requirements"}}<input type="text" name="system.requirements" value="{{system.requirements}}"></label>
      <div class="form-grid">
        <label>{{localize "ASOIAF.Drawback.flawAbility"}}
          <select name="system.flawAbility"><option value="">—</option>{{selectOptions abilityOptions selected=system.flawAbility localize=true}}</select>
        </label>
        <label>{{localize "ASOIAF.Drawback.flawDice"}}<input type="number" min="0" name="system.flawDice" value="{{system.flawDice}}"></label>
      </div>
      <p class="hint">{{localize "ASOIAF.Drawback.hint"}}</p>
    {{/if}}

    {{#if isType.holding}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Holding.resource"}}<select name="system.resource">{{selectOptions resourceOptions selected=system.resource localize=true}}</select></label>
        <label>{{localize "ASOIAF.Holding.investment"}}<input type="number" min="0" name="system.investment" value="{{system.investment}}"></label>
        <label>{{localize "ASOIAF.Holding.time"}}<input type="text" name="system.time" value="{{system.time}}"></label>
        <label>{{localize "ASOIAF.Holding.monthsRemaining"}}<input type="number" min="0" name="system.monthsRemaining" value="{{system.monthsRemaining}}"></label>
        <label data-tooltip="ASOIAF.Holding.fortuneHint">{{localize "ASOIAF.Holding.fortune"}}<input type="text" name="system.fortune" value="{{system.fortune}}"></label>
        <label>{{localize "ASOIAF.Holding.defenseBonus"}}<input type="number" min="0" name="system.defenseBonus" value="{{system.defenseBonus}}"></label>
      </div>
      <label class="block">{{localize "ASOIAF.Holding.requirement"}}<input type="text" name="system.requirement" value="{{system.requirement}}"></label>
      {{#if system.linked}}
        <p><i class="fa-solid fa-flag"></i> {{localize "ASOIAF.Holding.linked"}} : <a data-action="openUuid" data-uuid="{{system.linked}}">{{linkedName}}</a></p>
      {{/if}}
    {{/if}}

    {{#if isType.domain}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Domain.terrain"}}<select name="system.terrain">{{selectOptions terrainOptions selected=system.terrain}}</select></label>
        <label>{{localize "ASOIAF.Common.cost"}}<strong class="big">{{system.investment}}</strong></label>
      </div>
      <h4>{{localize "ASOIAF.Domain.features"}}</h4>
      <div class="features-grid">
        {{#each features}}
          <label><span>{{label}} <small>(+{{cost}})</small></span>
            <input class="mini" type="number" min="0" name="system.features.{{key}}" value="{{value}}"></label>
        {{/each}}
      </div>
    {{/if}}

    {{#if isType.unit}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Unit.training"}}<select name="system.training">{{selectOptions trainingOptions selected=system.training}}</select></label>
        <label>{{localize "ASOIAF.Unit.status"}}<select name="system.status">{{selectOptions statusOptions selected=system.status localize=true}}</select></label>
        <label>{{localize "ASOIAF.Unit.disciplineMod"}}<input type="number" name="system.disciplineMod" value="{{system.disciplineMod}}"></label>
        <label data-tooltip="ASOIAF.Unit.discountHint">{{localize "ASOIAF.Unit.discount"}}<input type="number" min="0" name="system.discount" value="{{system.discount}}"></label>
      </div>
      <div class="unit-summary">
        <span>{{localize "ASOIAF.Common.cost"}} : <strong>{{system.investment}}</strong></span>
        <span>{{localize "ASOIAF.Unit.discipline"}} : <strong>{{system.discipline}}</strong></span>
        <span>{{localize "ASOIAF.Unit.experience"}} : <strong>{{system.experience}}</strong></span>
        {{#if system.wealthCost}}<span>{{localize "ASOIAF.Resource.wealth"}} : <strong>-{{system.wealthCost}}</strong></span>{{/if}}
        {{#if system.populationCost}}<span>{{localize "ASOIAF.Resource.population"}} : <strong>-{{system.populationCost}}</strong></span>{{/if}}
      </div>
      <h4>{{localize "ASOIAF.Unit.types"}}</h4>
      <div class="features-grid">
        {{#each unitTypes}}
          <label class="checkbox"><input type="checkbox" name="system.types.{{key}}" {{checked checked}}>
            {{label}} <small>({{cost}} / {{discipline}})</small></label>
        {{/each}}
      </div>
      {{#if system.types.special}}
        <div class="form-grid special-abilities">
          <label>{{localize "ASOIAF.Unit.specialAbility"}} 1<select name="system.special1"><option value="">—</option>{{selectOptions abilityOptions selected=system.special1 localize=true}}</select></label>
          <label>{{localize "ASOIAF.Unit.specialAbility"}} 2<select name="system.special2"><option value="">—</option>{{selectOptions abilityOptions selected=system.special2 localize=true}}</select></label>
          <label>{{localize "ASOIAF.Unit.specialAbility"}} 3<select name="system.special3"><option value="">—</option>{{selectOptions abilityOptions selected=system.special3 localize=true}}</select></label>
        </div>
        <p class="hint">{{localize "ASOIAF.Unit.specialHint"}}</p>
      {{/if}}
      <label class="block">{{localize "ASOIAF.Unit.abilities"}}<input type="text" name="system.abilities" value="{{system.abilities}}" placeholder="{{localize 'ASOIAF.Unit.abilitiesPlaceholder'}}"></label>
    {{/if}}

    {{#if isType.artisan}}
      <div class="form-grid">
        <label>{{localize "ASOIAF.Artisan.trade"}}<input type="text" name="system.trade" value="{{system.trade}}" placeholder="{{localize 'ASOIAF.Artisan.tradePlaceholder'}}"></label>
        <label>{{localize "ASOIAF.Artisan.ability"}}<select name="system.ability">{{selectOptions abilityOptions selected=system.ability localize=true}}</select></label>
        <label>{{localize "ASOIAF.Artisan.rank"}}<input type="number" min="1" max="10" name="system.rank" value="{{system.rank}}"></label>
        <label>{{localize "ASOIAF.Roll.bonusDice"}}<input type="number" min="0" name="system.bonusDice" value="{{system.bonusDice}}"></label>
        <label data-tooltip="ASOIAF.Artisan.modifierHint">{{localize "ASOIAF.Artisan.modifier"}}<input type="number" name="system.modifier" value="{{system.modifier}}"></label>
        <label>{{localize "ASOIAF.Artisan.penalty"}}<input type="number" min="0" name="system.penalty" value="{{system.penalty}}"></label>
        <label>{{localize "ASOIAF.Artisan.budget"}} (max {{artisanMax}})<input type="number" min="0" max="{{artisanMax}}" name="system.budget" value="{{system.budget}}"></label>
        <label>{{localize "ASOIAF.Artisan.xp"}}<input type="number" min="0" name="system.xp" value="{{system.xp}}"></label>
        <label data-tooltip="ASOIAF.Artisan.investmentHint">{{localize "ASOIAF.Artisan.investment"}}<input type="number" min="0" name="system.investment" value="{{system.investment}}"></label>
        <label data-tooltip="ASOIAF.Holding.fortuneHint">{{localize "ASOIAF.Holding.fortune"}}<input type="text" name="system.fortune" value="{{system.fortune}}"></label>
        <label>{{localize "ASOIAF.Artisan.loan"}}<select name="system.loan">{{selectOptions loanOptions selected=system.loan localize=true}}</select></label>
        <label class="checkbox"><input type="checkbox" name="system.loanFree" {{checked system.loanFree}}> {{localize "ASOIAF.Artisan.loanFree"}}</label>
      </div>
      <p class="hint">{{localize "ASOIAF.Artisan.loanHint"}}</p>
      <label class="block">{{localize "ASOIAF.Artisan.productions"}}<input type="text" name="system.productions" value="{{system.productions}}"></label>
      <label class="block">{{localize "ASOIAF.Artisan.project"}}<input type="text" name="system.project" value="{{system.project}}"></label>
    {{/if}}

    {{#if hasModifiers}}
      <h4>{{localize "ASOIAF.Modifier.title"}}
        {{#if editable}}<a class="add" data-action="modAdd" data-tooltip="ASOIAF.Modifier.add"><i class="fa-solid fa-plus"></i></a>{{/if}}</h4>
      <p class="hint">{{localize "ASOIAF.Modifier.hint"}}</p>
      <datalist id="asoiaf-targets-{{item.id}}">
        {{#each targetSuggestions}}<option value="{{value}}">{{label}}</option>{{/each}}
      </datalist>
      <table class="items-table modifiers">
        <thead><tr>
          <th>{{localize "ASOIAF.Modifier.type"}}</th><th>{{localize "ASOIAF.Modifier.target"}}</th>
          <th>{{localize "ASOIAF.Modifier.value"}}</th><th data-tooltip="ASOIAF.Modifier.situationalHint">{{localize "ASOIAF.Modifier.situational"}}</th>
          <th>{{localize "ASOIAF.Modifier.label"}}</th><th></th>
        </tr></thead>
        <tbody>
          {{#each modifierRows}}
            <tr class="{{#if pending}}pending{{/if}}">
              <td><select data-mod-index="{{index}}" data-key="type">{{selectOptions @root.modifierTypes selected=type localize=true}}</select></td>
              <td><input type="text" list="asoiaf-targets-{{@root.item.id}}" data-mod-index="{{index}}" data-key="target" value="{{target}}"
                {{#if pending}}data-tooltip="ASOIAF.Modifier.pending"{{/if}}></td>
              <td><input type="text" class="short" data-mod-index="{{index}}" data-key="value" value="{{value}}"></td>
              <td class="center"><input type="checkbox" data-mod-index="{{index}}" data-key="situational" {{checked situational}}></td>
              <td><input type="text" data-mod-index="{{index}}" data-key="label" value="{{label}}"></td>
              <td class="controls">{{#if @root.editable}}<a data-action="modDelete" data-index="{{index}}"><i class="fa-solid fa-trash"></i></a>{{/if}}</td>
            </tr>
          {{else}}
            <tr><td colspan="6" class="hint">{{localize "ASOIAF.Modifier.none"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      <details class="modifier-help"><summary>{{localize "ASOIAF.Modifier.helpTitle"}}</summary><p>{{localize "ASOIAF.Modifier.help"}}</p></details>
    {{/if}}

    <label class="block">{{localize "ASOIAF.Common.description"}}<textarea name="system.description" rows="6">{{system.description}}</textarea></label>
  </section>
</div>
