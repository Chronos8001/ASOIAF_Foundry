<div class="asoiaf-dialog">
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.testDice"}}</label>
    <input type="number" name="testDice" value="{{testDice}}" min="1">
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.bonusDice"}}</label>
    <input type="number" name="bonusDice" value="{{bonusDice}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.penaltyDice"}}</label>
    <input type="number" name="penaltyDice" value="{{penaltyDice}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.modifier"}}</label>
    <input type="number" name="modifier" value="{{modifier}}">
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.difficulty"}}{{#if targetName}} <small>({{targetName}})</small>{{/if}}</label>
    <input type="number" name="difficulty" value="{{difficulty}}" list="asoiaf-difficulties" placeholder="—">
    <datalist id="asoiaf-difficulties">
      {{#each difficulties}}<option value="{{value}}">{{label}}</option>{{/each}}
    </datalist>
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.convert"}}</label>
    <input type="number" name="convert" value="{{convert}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.reroll1"}}</label>
    <input type="number" name="reroll1" value="{{reroll1}}" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "ASOIAF.Roll.reroll6"}}</label>
    <input type="checkbox" name="reroll6" {{checked reroll6}}>
  </div>
  {{#if attack}}
    <fieldset class="attack-options">
      <legend>{{localize "ASOIAF.Attack.title"}}</legend>
      <div class="form-group">
        <label>{{localize "ASOIAF.Attack.action"}}</label>
        <select name="action">{{#each attack.actions}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
      </div>
      <div class="attack-checks">
        <label class="checkbox"><input type="checkbox" name="aim"> {{localize "ASOIAF.Attack.aim"}}</label>
        <label class="checkbox"><input type="checkbox" name="surprise"> {{localize "ASOIAF.Attack.surprise"}}</label>
        {{#if attack.melee}}<label class="checkbox"><input type="checkbox" name="higherGround"> {{localize "ASOIAF.Attack.higherGround"}}</label>{{/if}}
        <label class="checkbox"><input type="checkbox" name="targetSprinted"> {{localize "ASOIAF.Attack.targetSprinted"}}</label>
        <label class="checkbox"><input type="checkbox" name="mounted" {{checked attack.mounted}}> {{localize "ASOIAF.Attack.mounted"}}</label>
        {{#if attack.melee}}<label class="checkbox"><input type="checkbox" name="targetMounted" {{checked attack.targetMounted}}> {{localize "ASOIAF.Attack.targetMounted"}}</label>{{/if}}
        {{#if attack.showTwoHands}}<label class="checkbox"><input type="checkbox" name="twoHands" {{checked attack.twoHands}}> {{localize "ASOIAF.Attack.twoHands"}}</label>{{/if}}
        {{#if attack.q.reach}}<label class="checkbox"><input type="checkbox" name="tooClose"> {{localize "ASOIAF.Attack.tooClose"}}</label>{{/if}}
      </div>
      {{#if attack.ranged}}
        <div class="form-group"><label>{{localize "ASOIAF.Attack.distance"}}</label><input type="number" name="distance" min="0" value="0"></div>
      {{/if}}
      {{#each attack.auto}}<p class="hint">{{this}}</p>{{/each}}
      {{#if attack.vicious}}<p class="hint">{{localize "ASOIAF.Defeat.vicious"}}</p>{{/if}}
      <p class="hint">{{localize "ASOIAF.Attack.hint"}}</p>
    </fieldset>
  {{/if}}
  {{#if convertHalf}}<p class="hint">{{localize "ASOIAF.Roll.convertHalf"}}</p>{{/if}}
  {{#if situational.length}}
    <fieldset class="situational">
      <legend>{{localize "ASOIAF.Roll.situational"}}</legend>
      {{#each situational}}
        <label class="checkbox"><input type="checkbox" name="sit_{{index}}">
          <span><strong>{{label}}</strong> <em>{{summary}}</em>{{#if (asEq label source)}}{{else}} <small>— {{source}}</small>{{/if}}</span></label>
      {{/each}}
    </fieldset>
  {{/if}}
  <p class="hint">{{localize "ASOIAF.Roll.hint"}}</p>
</div>
