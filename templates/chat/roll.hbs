<div class="asoiaf-chat roll-card">
  <h3>{{label}}</h3>
  <div class="dice-row">
    {{#each dice}}<span class="die {{status}} {{#if original}}rerolled{{/if}}"{{#if original}} data-tooltip="{{localize 'ASOIAF.Roll.rerolledFrom'}} {{original}}"{{/if}}>{{value}}</span>{{/each}}
  </div>
  <div class="roll-meta">
    <span>{{testDice}} {{localize "ASOIAF.Roll.testDiceShort"}}</span>
    {{#if bonusDice}}<span>+{{bonusDice}}B</span>{{/if}}
    {{#if penaltyDice}}<span class="penalty">-{{penaltyDice}}D</span>{{/if}}
    {{#if modifier}}<span>{{asSigned modifier}}</span>{{/if}}
    {{#if converted}}<span>{{converted}}B → D</span>{{/if}}
    {{#if rerolls}}<span>{{rerolls}} {{localize "ASOIAF.Roll.rerolledShort"}}</span>{{/if}}
    {{#if extraFormula}}<span>{{extraFormula}} = {{asSigned extraTotal}}</span>{{/if}}
  </div>
  <div class="roll-total">{{total}}</div>
  {{#if outcome}}
    <div class="outcome {{#if outcome.success}}success{{else}}failure{{/if}}">
      {{#if difficulty}}<span class="vs">{{localize "ASOIAF.Roll.vs"}} {{difficulty}}</span>{{/if}}
      <strong>{{outcome.label}}</strong>
      {{#if outcome.success}}<span class="degrees">{{outcome.degrees}} {{localize "ASOIAF.Roll.degrees"}}</span>{{/if}}
    </div>
  {{/if}}
  {{#if damage}}
    <div class="damage">
      {{#if damage.total}}
        <span>{{localize "ASOIAF.Weapon.damage"}} : {{damage.base}} × {{damage.degrees}}{{#if damage.after}} {{asSigned damage.after}}{{/if}} = <strong>{{damage.total}}</strong>{{#if damage.piercing}} ({{#if (asGt damage.piercing 20)}}{{localize "ASOIAF.Siege.ignoresArmor"}}{{else}}{{localize "ASOIAF.Weapon.piercing"}} {{damage.piercing}}{{/if}}){{/if}}{{#if damage.burn}} · <i class="fa-solid fa-fire"></i> {{damage.burn.damage}} / round ({{damage.burn.rounds}}){{/if}}</span>
        <button type="button" data-action="apply-damage" data-damage="{{damage.total}}" data-piercing="{{damage.piercing}}"
          {{#if damage.targetUuid}}data-target-uuid="{{damage.targetUuid}}"{{/if}} data-vicious="{{damage.vicious}}"
          {{#if damage.burn}}data-burn-damage="{{damage.burn.damage}}" data-burn-rounds="{{damage.burn.rounds}}"{{/if}}>
          <i class="fa-solid fa-heart-crack"></i> {{localize "ASOIAF.Chat.applyDamage"}}
        </button>
      {{else}}
        <span>{{localize "ASOIAF.Weapon.damage"}} : {{damage.base}} × {{localize "ASOIAF.Roll.degrees"}}</span>
      {{/if}}
    </div>
  {{/if}}
  {{#if critical}}
    <div class="critical {{critical.type}}"><strong>{{critical.title}}</strong> — {{critical.text}}</div>
  {{/if}}
  {{#if buttons.length}}
    <div class="buttons-row effect-buttons">
      {{#each buttons}}
        <button type="button" data-action="combat-effect" data-effect="{{effect}}" data-degrees="{{degrees}}"
          {{#if value}}data-value="{{value}}"{{/if}} {{#if damage}}data-damage="{{damage}}" data-piercing="{{piercing}}"{{/if}}>{{label}}</button>
      {{/each}}
    </div>
  {{/if}}
  {{#if poison}}
    <div class="poison-coat">
      <button type="button" data-action="apply-poison"><i class="fa-solid fa-flask"></i> {{localize "ASOIAF.Poison.applyCoat"}} ({{poison.name}})</button>
    </div>
  {{/if}}
  {{#if effects.length}}<ul class="applied-effects">{{#each effects}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
  {{#if extra}}<p class="hint">{{extra}}</p>{{/if}}
</div>
