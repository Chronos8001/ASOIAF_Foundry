<div class="asoiaf-sheet">
  {{!-- En-tête --}}
  <header class="sheet-header">
    <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-field="img">
    <div class="header-main">
      <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'ASOIAF.Common.name'}}">
      <div class="header-grid">
        <label>{{localize "ASOIAF.Character.house"}}
          {{#if house}}
            <span class="house-link">
              <a data-action="openUuid" data-uuid="{{house.uuid}}"><img src="{{house.img}}" alt="">{{house.name}}</a>
              <a class="icon" data-action="unlinkHouse" data-tooltip="ASOIAF.Character.unlinkHouse"><i class="fa-solid fa-link-slash"></i></a>
            </span>
            <small class="{{#if statusWarning}}warning{{/if}}">{{localize "ASOIAF.House.maxStatus"}} : {{house.maxStatus}}</small>
          {{else}}
            <span class="hint">{{localize "ASOIAF.Character.dropHouse"}}</span>
          {{/if}}
        </label>
        <label>{{localize "ASOIAF.Character.position"}}
          <input type="text" name="system.position" value="{{system.position}}">
        </label>
        <label>{{localize "ASOIAF.Character.age"}}
          <select name="system.age">{{selectOptions ageOptions selected=system.age localize=true}}</select>
        </label>
        <label>{{localize "ASOIAF.Character.xp"}}
          <span class="pair">
            <input type="number" name="system.xp.total" value="{{system.xp.total}}" data-tooltip="ASOIAF.Character.xpTotal">
            <span>/</span>
            <input type="number" name="system.xp.spent" value="{{system.xp.spent}}" data-tooltip="ASOIAF.Character.xpSpent">
          </span>
        </label>
      </div>
      <div class="derived-strip">
        <div class="derived"><span>{{localize "ASOIAF.Derived.combatDefense"}}</span><strong>{{system.combatDefense}}</strong></div>
        <div class="derived"><span>{{localize "ASOIAF.Derived.intrigueDefense"}}</span><strong>{{system.intrigueDefense}}</strong></div>
        <div class="derived"><span>{{localize "ASOIAF.Derived.armorRating"}}</span><strong>{{system.armor.rating}}</strong></div>
        <div class="derived"><span>{{localize "ASOIAF.Derived.movement"}}</span><strong>{{system.movement}} <small>/ {{system.sprint}}</small></strong></div>
        <div class="derived"><span>{{localize "ASOIAF.Destiny.points"}}</span><strong>{{system.destiny.value}}</strong></div>
      </div>
    </div>
  </header>

  {{!-- Jauges --}}
  <section class="tracks">
    <div class="track">
      <div class="track-head">
        <span>{{localize "ASOIAF.Derived.health"}}</span>
        <span class="pair"><input type="number" name="system.health.value" value="{{system.health.value}}"> / {{system.health.max}}</span>
      </div>
      <div class="bar health"><div style="width:{{healthPct}}%"></div></div>
    </div>
    <div class="track">
      <div class="track-head">
        <span>{{localize "ASOIAF.Derived.composure"}}</span>
        <span class="pair"><input type="number" name="system.composure.value" value="{{system.composure.value}}"> / {{system.composure.max}}</span>
      </div>
      <div class="bar composure"><div style="width:{{composurePct}}%"></div></div>
    </div>
  </section>

  <nav class="sheet-tabs">
    {{#each tabs}}
      <a class="{{cssClass}}" data-action="asTab" data-tab="{{id}}">{{localize label}}</a>
    {{/each}}
  </nav>

  <section class="sheet-body">
    {{!-- Capacités --}}
    <div class="tab-panel {{#if (asEq activeTab 'abilities')}}active{{/if}}" data-tab="abilities">
      <p class="hint">{{localize "ASOIAF.Character.abilitiesHint"}}</p>
      <div class="abilities-grid">
        {{#each abilities}}
          <div class="ability">
            <div class="ability-head">
              <a class="ability-name rollable" data-action="rollAbility" data-ability="{{key}}">
                <i class="fa-solid fa-dice-six"></i> {{label}}
              </a>
              {{#if flaws}}<span class="flaw" data-tooltip="ASOIAF.Character.flawTooltip">-{{flaws}}D</span>{{/if}}
              <input class="rank" type="number" min="1" max="7" name="system.abilities.{{key}}.value" value="{{value}}">
            </div>
            {{#if specialties.length}}
              <ul class="specialties">
                {{#each specialties}}
                  <li class="{{#if value}}has-value{{/if}} {{#if over}}over{{/if}}">
                    <a class="rollable" data-action="rollAbility" data-ability="{{../key}}" data-specialty="{{this.key}}">{{this.label}}</a>
                    <input type="number" min="0" max="7" name="system.abilities.{{../key}}.specialties.{{this.key}}" value="{{this.value}}"><span>B</span>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <textarea class="languages" name="system.languages" rows="2" placeholder="{{localize 'ASOIAF.Character.languages'}}">{{../system.languages}}</textarea>
            {{/if}}
          </div>
        {{/each}}
      </div>
    </div>

    {{!-- Combat --}}
    <div class="tab-panel {{#if (asEq activeTab 'combat')}}active{{/if}}" data-tab="combat">
      <div class="two-cols">
        <fieldset>
          <legend>{{localize "ASOIAF.Combat.condition"}}</legend>
          <div class="slots-row">
            <span class="slots-label" data-tooltip="ASOIAF.Combat.injuryHint">{{localize "ASOIAF.Combat.injuries"}} <small>(-1)</small></span>
            <span class="slots">{{#each injurySlots}}<a class="slot {{#if filled}}filled{{/if}}" data-action="setCount" data-field="system.injuries" data-index="{{@index}}" data-tooltip="ASOIAF.Combat.slotHint"></a>{{/each}}</span>
            <input type="number" min="0" name="system.injuries" value="{{system.injuries}}">
            <button type="button" data-action="step" data-field="system.injuries" data-delta="-1" data-tooltip="ASOIAF.Combat.heal"><i class="fa-solid fa-minus"></i></button>
            <button type="button" data-action="injury" data-tooltip="ASOIAF.Combat.injuryHint"><i class="fa-solid fa-droplet"></i></button>
          </div>
          <div class="slots-row">
            <span class="slots-label" data-tooltip="ASOIAF.Combat.woundHint">{{localize "ASOIAF.Combat.wounds"}} <small>(-1D)</small></span>
            <span class="slots">{{#each woundSlots}}<a class="slot wound {{#if filled}}filled{{/if}}" data-action="setCount" data-field="system.wounds" data-index="{{@index}}" data-tooltip="ASOIAF.Combat.slotHint"></a>{{/each}}</span>
            <input type="number" min="0" name="system.wounds" value="{{system.wounds}}">
            <button type="button" data-action="step" data-field="system.wounds" data-delta="-1" data-tooltip="ASOIAF.Combat.heal"><i class="fa-solid fa-minus"></i></button>
            <button type="button" data-action="wound" data-tooltip="ASOIAF.Combat.woundHint"><i class="fa-solid fa-skull"></i></button>
          </div>
          <div class="slots-row">
            <span class="slots-label" data-tooltip="ASOIAF.Fatigue.hint">{{localize "ASOIAF.Fatigue.title"}} <small>(-1)</small></span>
            <span class="slots">{{#each fatigueSlots}}<a class="slot {{#if filled}}filled{{/if}}" data-action="setCount" data-field="system.fatigue" data-index="{{@index}}" data-tooltip="ASOIAF.Combat.slotHint"></a>{{/each}}</span>
            <button type="button" data-action="combatAction" data-fn="takeFatigue" data-tooltip="ASOIAF.Fatigue.take"><i class="fa-solid fa-person-running"></i></button>
            <button type="button" data-action="combatAction" data-fn="rest" data-tooltip="ASOIAF.Fatigue.rest"><i class="fa-solid fa-moon"></i></button>
          </div>
          <div class="buttons-row">
            <button type="button" data-action="recover" data-kind="combat"><i class="fa-solid fa-bed"></i> {{localize "ASOIAF.Combat.endCombat"}}</button>
            <button type="button" data-action="combatAction" data-fn="recoverWounds" data-tooltip="ASOIAF.Recovery.hint"><i class="fa-solid fa-kit-medical"></i> {{localize "ASOIAF.Recovery.title"}}</button>
          </div>
        </fieldset>
        <fieldset>
          <legend>{{localize "ASOIAF.Combat.defense"}}</legend>
          <ul class="breakdown">
            <li>{{localize "ASOIAF.Ability.agility"}} + {{localize "ASOIAF.Ability.athletics"}} + {{localize "ASOIAF.Ability.awareness"}}</li>
            <li>{{localize "ASOIAF.Combat.armorPenalty"}} : {{asSigned system.armor.penalty}}</li>
            <li>{{localize "ASOIAF.Combat.defensiveBonus"}} : +{{system.defensiveBonus}}</li>
            <li><strong>{{localize "ASOIAF.Derived.combatDefense"}} : {{system.combatDefense}}</strong></li>
            <li>{{localize "ASOIAF.Combat.bulk"}} : {{system.bulk}}</li>
            <li><label>{{localize "ASOIAF.Size.label"}} <select name="system.size">{{selectOptions sizeOptions selected=system.size localize=true}}</select></label></li>
          </ul>
        </fieldset>
      </div>

      <h3 class="section-title">{{localize "ASOIAF.Action.title"}}</h3>
      <div class="combat-actions">
        <button type="button" data-action="combatAction" data-fn="dodge" data-tooltip="ASOIAF.Action.dodgeHint"><i class="fa-solid fa-person-falling"></i> {{localize "ASOIAF.Action.dodge"}}</button>
        <button type="button" data-action="combatAction" data-fn="knockdown" data-tooltip="ASOIAF.Action.knockdownHint"><i class="fa-solid fa-hand-back-fist"></i> {{localize "ASOIAF.Action.knockdown"}}</button>
        <button type="button" data-action="combatAction" data-fn="distract" data-tooltip="ASOIAF.Action.distractHint"><i class="fa-solid fa-eye-slash"></i> {{localize "ASOIAF.Action.distract"}}</button>
        <button type="button" data-action="combatAction" data-fn="catchBreath" data-tooltip="ASOIAF.Action.catchBreathHint"><i class="fa-solid fa-lungs"></i> {{localize "ASOIAF.Action.catchBreath"}}</button>
        <button type="button" data-action="combatAction" data-fn="joust" data-tooltip="ASOIAF.Joust.tooltip"><i class="fa-solid fa-horse-head"></i> {{localize "ASOIAF.Joust.title"}}</button>
        {{#if has.prone}}<button type="button" data-action="combatAction" data-fn="standUp"><i class="fa-solid fa-person-arrow-up-from-line"></i> {{localize "ASOIAF.Action.standUp"}}</button>{{/if}}
        {{#if has.entangled}}
          <button type="button" data-action="combatAction" data-fn="freeEntangled"><i class="fa-solid fa-dumbbell"></i> {{localize "ASOIAF.Action.free_entangled"}}</button>
          <button type="button" data-action="combatAction" data-fn="freeEntangledAgility"><i class="fa-solid fa-person-walking"></i> {{localize "ASOIAF.Action.free_entangledAgility"}}</button>
        {{/if}}
        {{#if has.stunned}}<button type="button" data-action="combatAction" data-fn="wakeUp"><i class="fa-solid fa-bolt"></i> {{localize "ASOIAF.Action.free_stunned"}}</button>{{/if}}
        {{#if has.impaled}}<button type="button" data-action="combatAction" data-fn="freeImpaled"><i class="fa-solid fa-hand"></i> {{localize "ASOIAF.Action.free_impaled"}}</button>{{/if}}
      </div>
      <p class="hint">{{localize "ASOIAF.Action.hint"}}</p>

      <div class="conditions-row">
        <strong>{{localize "ASOIAF.Condition.title"}} :</strong>
        {{#each conditions}}
          <span class="tag condition" data-tooltip="{{hint}}"><img src="{{img}}" alt=""> {{label}}{{#if value}} ({{value}}){{/if}}{{#if rounds}} — {{rounds}} r.{{/if}}
            <a data-action="removeCondition" data-condition="{{key}}"><i class="fa-solid fa-xmark"></i></a></span>
        {{else}}
          <span class="hint">{{localize "ASOIAF.Condition.none"}}</span>
        {{/each}}
      </div>
      <div class="buttons-row">
        <button type="button" data-action="toggleCondition" data-condition="mounted" class="{{#if has.mounted}}active{{/if}}"><i class="fa-solid fa-horse"></i> {{localize "ASOIAF.Condition.mounted"}}</button>
        <button type="button" data-action="toggleCondition" data-condition="prone" class="{{#if has.prone}}active{{/if}}"><i class="fa-solid fa-person-falling-burst"></i> {{localize "ASOIAF.Condition.prone"}}</button>
        <button type="button" data-action="setCover" data-value="5"><i class="fa-solid fa-shield-halved"></i> {{localize "ASOIAF.Condition.cover"}} +5</button>
        <button type="button" data-action="setCover" data-value="10"><i class="fa-solid fa-shield"></i> {{localize "ASOIAF.Condition.cover"}} +10</button>
        {{#if has.cover}}<button type="button" data-action="setCover" data-value="0"><i class="fa-solid fa-xmark"></i> {{localize "ASOIAF.Condition.noCover"}}</button>{{/if}}
      </div>

      {{#if afflictions.length}}
        <h3 class="section-title"><i class="fa-solid fa-flask"></i> {{localize "ASOIAF.Poison.afflictions"}}</h3>
        <ul class="item-list afflictions">
          {{#each afflictions}}
            <li data-item-id="{{id}}" class="{{#if dead}}dead{{/if}}">
              <img src="{{img}}" alt="">
              <div class="grow">
                <strong>{{name}}</strong>
                {{#if servings}}<span class="tag">{{servings}} {{localize "ASOIAF.Poison.servings"}}</span>{{/if}}
                {{#if unconscious}}<span class="tag flaw"><i class="fa-solid fa-bed"></i> {{localize "ASOIAF.Poison.unconscious"}} ({{unconscious}})</span>{{/if}}
                {{#if dead}}<span class="tag flaw"><i class="fa-solid fa-skull"></i> {{localize "ASOIAF.Poison.dead"}}</span>{{/if}}
                {{#if diagnosed}}<span class="tag"><i class="fa-solid fa-stethoscope"></i> {{localize "ASOIAF.Poison.diagnosedTag"}}{{#if treatment}} ({{treatment}}){{/if}}</span>{{/if}}
                {{#each stages}}
                  <div class="effects-line">{{label}} : {{left}} × {{every}}{{#if next}} — {{localize "ASOIAF.Poison.nextIn"}} {{next}}{{/if}}{{#if waiting}} — {{localize "ASOIAF.Poison.waiting"}}{{/if}}</div>
                {{/each}}
                {{#if penalties}}<div class="desc">{{penalties}}</div>{{/if}}
                {{#if recoveryText}}<div class="hint">{{recoveryText}}</div>{{/if}}
                {{#if @root.editable}}
                  <div class="buttons-row">
                    {{#if hasAttacks}}
                      <button type="button" data-action="poisonNext" data-tooltip="ASOIAF.Poison.nextHint"><i class="fa-solid fa-forward-step"></i> {{localize "ASOIAF.Poison.next"}}</button>
                      <button type="button" data-action="poisonResolve" data-tooltip="ASOIAF.Poison.resolveHint"><i class="fa-solid fa-forward-fast"></i> {{localize "ASOIAF.Poison.resolve"}}</button>
                    {{/if}}
                    {{#unless diagnosed}}<button type="button" data-action="poisonDiagnose" data-tooltip="ASOIAF.Poison.healerHint"><i class="fa-solid fa-stethoscope"></i> {{localize "ASOIAF.Poison.diagnose"}}</button>{{/unless}}
                    {{#if diagnosed}}<button type="button" data-action="poisonTreat" data-tooltip="ASOIAF.Poison.healerHint"><i class="fa-solid fa-kit-medical"></i> {{localize "ASOIAF.Poison.treat"}}</button>{{/if}}
                    {{#if canRecover}}<button type="button" data-action="poisonRecover"><i class="fa-solid fa-heart-pulse"></i> {{localize "ASOIAF.Poison.recover"}}</button>{{/if}}
                    <button type="button" data-action="poisonDestiny" data-tooltip="ASOIAF.Poison.burnHint"><i class="fa-solid fa-fire"></i> {{localize "ASOIAF.Poison.burnDestiny"}}</button>
                  </div>
                {{/if}}
              </div>
              <span class="controls"><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete" data-tooltip="ASOIAF.Poison.removeHint"><i class="fa-solid fa-trash"></i></a></span>
            </li>
          {{/each}}
        </ul>
      {{/if}}

      <h3 class="section-title">{{localize "ASOIAF.Combat.weapons"}}</h3>
      <table class="items-table">
        <thead><tr>
          <th></th><th>{{localize "ASOIAF.Common.name"}}</th><th>{{localize "ASOIAF.Weapon.specialty"}}</th>
          <th>{{localize "ASOIAF.Weapon.training"}}</th><th>{{localize "ASOIAF.Weapon.damage"}}</th>
          <th>{{localize "ASOIAF.Weapon.qualities"}}</th><th></th>
        </tr></thead>
        <tbody>
          {{#each weapons}}
            <tr data-item-id="{{id}}">
              <td><a class="equip {{#if item.system.equipped}}on{{/if}}" data-action="itemToggle" data-tooltip="ASOIAF.Common.equipped"><i class="fa-solid fa-hand-fist"></i></a></td>
              <td><a class="rollable item-name" data-action="rollWeapon"><img src="{{item.img}}" alt=""> {{item.name}}</a>
                {{#if grade}}<span class="tag">{{grade}}</span>{{/if}}
                {{#if coating}}<span class="tag flaw" data-tooltip="ASOIAF.Poison.coatedTag"><i class="fa-solid fa-flask"></i> {{coating}}
                  <a data-action="removeCoating"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</td>
              <td>{{specialtyLabel}}</td>
              <td class="{{#if trainingWarning}}warning{{/if}}">{{#if item.system.training}}{{item.system.training}}B{{else}}—{{/if}}</td>
              <td class="center"><strong>{{damage}}</strong></td>
              <td class="qualities">{{item.system.qualities}}</td>
              <td class="controls">
                <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a>
                <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}
        <div class="catalog-row">
          <select data-catalog="weapon">{{#each weaponCatalog}}<option value="{{index}}">{{name}}</option>{{/each}}</select>
          <button type="button" data-action="addFromCatalog" data-kind="weapon"><i class="fa-solid fa-plus"></i> {{localize "ASOIAF.Common.addFromBook"}}</button>
          <button type="button" data-action="itemCreate" data-type="weapon"><i class="fa-solid fa-plus"></i> {{localize "ASOIAF.Common.custom"}}</button>
        </div>
      {{/if}}

      <h3 class="section-title">{{localize "ASOIAF.Combat.armor"}}</h3>
      <table class="items-table">
        <thead><tr>
          <th></th><th>{{localize "ASOIAF.Common.name"}}</th><th>{{localize "ASOIAF.Armor.rating"}}</th>
          <th>{{localize "ASOIAF.Armor.penalty"}}</th><th>{{localize "ASOIAF.Combat.bulk"}}</th><th></th>
        </tr></thead>
        <tbody>
          {{#each armors}}
            <tr data-item-id="{{id}}">
              <td><a class="equip {{#if system.equipped}}on{{/if}}" data-action="itemToggle" data-tooltip="ASOIAF.Common.equipped"><i class="fa-solid fa-shirt"></i></a></td>
              <td class="item-name"><img src="{{img}}" alt=""> {{name}}</td>
              <td class="center">{{system.rating}}</td>
              <td class="center">{{system.penalty}}</td>
              <td class="center">{{system.bulk}}</td>
              <td class="controls">
                <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a>
                <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}
        <div class="catalog-row">
          <select data-catalog="armor">{{#each armorCatalog}}<option value="{{index}}">{{name}}</option>{{/each}}</select>
          <button type="button" data-action="addFromCatalog" data-kind="armor"><i class="fa-solid fa-plus"></i> {{localize "ASOIAF.Common.addFromBook"}}</button>
        </div>
      {{/if}}
    </div>

    {{!-- Intrigue --}}
    <div class="tab-panel {{#if (asEq activeTab 'intrigue')}}active{{/if}}" data-tab="intrigue">
      <div class="two-cols">
        <fieldset>
          <legend>{{localize "ASOIAF.Intrigue.title"}}</legend>
          <ul class="breakdown">
            <li>{{localize "ASOIAF.Ability.awareness"}} + {{localize "ASOIAF.Ability.cunning"}} + {{localize "ASOIAF.Ability.status"}}</li>
            <li><strong>{{localize "ASOIAF.Derived.intrigueDefense"}} : {{system.intrigueDefense}}</strong></li>
            <li>{{localize "ASOIAF.Derived.composure"}} : {{system.composure.value}} / {{system.composure.max}}
              <input class="mini" type="number" min="0" name="system.composure.value" value="{{system.composure.value}}"></li>
            <li><label>{{localize "ASOIAF.Intrigue.location"}} <select name="system.intrigue.locationBonus">{{selectOptions locationOptions selected=system.intrigue.locationBonus}}</select></label></li>
          </ul>
          <div class="slots-row">
            <span class="slots-label" data-tooltip="ASOIAF.Intrigue.frustrationHint">{{localize "ASOIAF.Intrigue.frustration"}} <small>(-1D)</small></span>
            <span class="slots">{{#each frustrationSlots}}<a class="slot {{#if filled}}filled{{/if}}" data-action="setCount" data-field="system.frustration" data-index="{{@index}}" data-tooltip="ASOIAF.Combat.slotHint"></a>{{/each}}</span>
            <button type="button" data-action="step" data-field="system.frustration" data-delta="-1" data-tooltip="ASOIAF.Combat.heal"><i class="fa-solid fa-minus"></i></button>
          </div>
          {{#each intrigueEffects}}<div class="effects-line">{{this}}</div>{{/each}}
        </fieldset>
        <fieldset>
          <legend>{{localize "ASOIAF.Intrigue.stance"}}</legend>
          <label class="block">{{localize "ASOIAF.Intrigue.disposition"}}
            <select name="system.intrigue.disposition">{{selectOptions dispositionOptions selected=system.intrigue.disposition}}</select></label>
          <label class="block">{{localize "ASOIAF.Intrigue.technique"}}
            <select name="system.intrigue.technique">{{selectOptions techniqueOptions selected=system.intrigue.technique}}</select></label>
          <p class="hint">{{techniqueHint}}</p>
          <label class="block">{{localize "ASOIAF.Intrigue.objective"}}
            <select name="system.intrigue.objective">{{selectOptions objectiveOptions selected=system.intrigue.objective}}</select></label>
          <label class="checkbox"><input type="checkbox" name="system.intrigue.deceit" {{checked system.intrigue.deceit}}> {{localize "ASOIAF.Intrigue.deceit"}}</label>
          <div class="pair victory">{{localize "ASOIAF.Intrigue.victory"}}
            <input type="number" name="system.intrigue.victory" value="{{system.intrigue.victory}}"> /
            <input type="number" min="0" name="system.intrigue.victoryGoal" value="{{system.intrigue.victoryGoal}}" data-tooltip="ASOIAF.Intrigue.victoryHint"></div>
        </fieldset>
      </div>

      <h3 class="section-title">{{localize "ASOIAF.IntrigueAction.title"}}</h3>
      <div class="combat-actions">
        <button type="button" class="primary" data-action="intrigueAction" data-fn="influence" data-tooltip="ASOIAF.IntrigueAction.influenceHint"><i class="fa-solid fa-comments"></i> {{localize "ASOIAF.IntrigueAction.influence"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="assist" data-tooltip="ASOIAF.IntrigueAction.assistHint"><i class="fa-solid fa-handshake-angle"></i> {{localize "ASOIAF.IntrigueAction.assist"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="consider" data-tooltip="ASOIAF.IntrigueAction.considerHint"><i class="fa-solid fa-hourglass-half"></i> {{localize "ASOIAF.IntrigueAction.consider"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="fastTalk" data-tooltip="ASOIAF.IntrigueAction.fastTalkHint"><i class="fa-solid fa-wind"></i> {{localize "ASOIAF.IntrigueAction.fastTalk"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="manipulate" data-tooltip="ASOIAF.IntrigueAction.manipulateHint"><i class="fa-solid fa-masks-theater"></i> {{localize "ASOIAF.IntrigueAction.manipulate"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="mollify" data-tooltip="ASOIAF.IntrigueAction.mollifyHint"><i class="fa-solid fa-dove"></i> {{localize "ASOIAF.IntrigueAction.mollify"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="readTarget" data-tooltip="ASOIAF.IntrigueAction.readTargetHint"><i class="fa-solid fa-magnifying-glass"></i> {{localize "ASOIAF.IntrigueAction.readTarget"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="reputation" data-tooltip="ASOIAF.IntrigueAction.reputationHint" {{#if system.intrigue.shieldUsed}}disabled{{/if}}><i class="fa-solid fa-crown"></i> {{localize "ASOIAF.IntrigueAction.reputation"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="withdraw" data-tooltip="ASOIAF.IntrigueAction.withdrawHint"><i class="fa-solid fa-shield-halved"></i> {{localize "ASOIAF.IntrigueAction.withdraw"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="recognition" data-tooltip="ASOIAF.IntrigueAction.recognitionHint"><i class="fa-solid fa-id-badge"></i> {{localize "ASOIAF.IntrigueAction.recognition"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="yield" data-tooltip="ASOIAF.IntrigueAction.yieldHint"><i class="fa-solid fa-flag"></i> {{localize "ASOIAF.IntrigueAction.yield"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="quit"><i class="fa-solid fa-door-open"></i> {{localize "ASOIAF.IntrigueAction.quit"}}</button>
      </div>
      <p class="hint">{{localize "ASOIAF.IntrigueAction.hint"}}</p>
      <div class="buttons-row">
        <button type="button" data-action="intrigueAction" data-fn="start" data-tooltip="ASOIAF.Intrigue.startHint"><i class="fa-solid fa-users"></i> {{localize "ASOIAF.Intrigue.start"}}</button>
        <button type="button" data-action="intrigueAction" data-fn="newExchange" data-tooltip="ASOIAF.Intrigue.newExchangeHint"><i class="fa-solid fa-rotate"></i> {{localize "ASOIAF.Intrigue.newExchange"}}</button>
        <button type="button" data-action="recover" data-kind="intrigue"><i class="fa-solid fa-mug-hot"></i> {{localize "ASOIAF.Intrigue.end"}}</button>
        <a class="rollable" data-action="rollAbility" data-ability="status" data-specialty="reputation"><i class="fa-solid fa-dice-six"></i> {{localize "ASOIAF.Intrigue.initiative"}}</a>
      </div>
    </div>

    {{!-- Destinée --}}
    <div class="tab-panel {{#if (asEq activeTab 'destiny')}}active{{/if}}" data-tab="destiny">
      <div class="destiny-row">
        <label>{{localize "ASOIAF.Destiny.points"}}
          <span class="stepper">
            <button type="button" data-action="step" data-field="system.destiny.value" data-delta="-1">−</button>
            <input type="number" name="system.destiny.value" value="{{system.destiny.value}}">
            <button type="button" data-action="step" data-field="system.destiny.value" data-delta="1">+</button>
          </span>
        </label>
        <label>{{localize "ASOIAF.Destiny.burned"}} <input type="number" name="system.destiny.burned" value="{{system.destiny.burned}}"></label>
        <label>{{localize "ASOIAF.Destiny.invested"}} <strong>{{system.destiny.invested}}</strong></label>
        <label>{{localize "ASOIAF.Character.glory"}} <input type="number" name="system.glory" value="{{system.glory}}"></label>
      </div>

      <h3 class="section-title">{{localize "ASOIAF.Destiny.benefits"}}
        {{#if editable}}<a class="add" data-action="itemCreate" data-type="benefit"><i class="fa-solid fa-plus"></i></a>{{/if}}</h3>
      <ul class="item-list">
        {{#each benefits}}
          <li data-item-id="{{id}}">
            <img src="{{img}}" alt="">
            <div class="grow"><strong>{{name}}</strong> {{#if system.category}}<em>({{system.category}})</em>{{/if}}
              {{#if pending}}<span class="tag pending" data-tooltip="ASOIAF.Modifier.pendingSheet"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ASOIAF.Modifier.toConfigure"}}</span>{{/if}}
              {{#if effects}}<div class="effects-line">{{effects}}</div>{{/if}}
              {{#if system.description}}<div class="desc">{{system.description}}</div>{{/if}}</div>
            <span class="tag">{{system.destinyCost}} {{localize "ASOIAF.Destiny.short"}}</span>
            <span class="controls"><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span>
          </li>
        {{/each}}
      </ul>

      <h3 class="section-title">{{localize "ASOIAF.Destiny.drawbacks"}}
        {{#if editable}}<a class="add" data-action="itemCreate" data-type="drawback"><i class="fa-solid fa-plus"></i></a>{{/if}}</h3>
      <ul class="item-list">
        {{#each drawbacks}}
          <li data-item-id="{{id}}">
            <img src="{{img}}" alt="">
            <div class="grow"><strong>{{name}}</strong>
              {{#if system.flawAbility}}<span class="tag flaw">-{{system.flawDice}}D {{localize (concat "ASOIAF.Ability." system.flawAbility)}}</span>{{/if}}
              {{#if pending}}<span class="tag pending" data-tooltip="ASOIAF.Modifier.pendingSheet"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "ASOIAF.Modifier.toConfigure"}}</span>{{/if}}
              {{#if effects}}<div class="effects-line">{{effects}}</div>{{/if}}
              {{#if system.description}}<div class="desc">{{system.description}}</div>{{/if}}</div>
            <span class="controls"><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></span>
          </li>
        {{/each}}
      </ul>
    </div>

    {{!-- Inventaire --}}
    <div class="tab-panel {{#if (asEq activeTab 'gear')}}active{{/if}}" data-tab="gear">
      <div class="coins">
        <label><i class="fa-solid fa-coins gold"></i> {{localize "ASOIAF.Coin.dragons"}} <input type="number" name="system.coin.dragons" value="{{system.coin.dragons}}"></label>
        <label><i class="fa-solid fa-coins silver"></i> {{localize "ASOIAF.Coin.stags"}} <input type="number" name="system.coin.stags" value="{{system.coin.stags}}"></label>
        <label><i class="fa-solid fa-coins copper"></i> {{localize "ASOIAF.Coin.pennies"}} <input type="number" name="system.coin.pennies" value="{{system.coin.pennies}}"></label>
      </div>
      <p class="hint">{{localize "ASOIAF.Inventory.hint"}}</p>
      <p class="inventory-totals">{{localize "ASOIAF.Inventory.purseTotal"}} : <strong>{{purse}}</strong> · {{localize "ASOIAF.Inventory.weight"}} : <strong>{{system.carriedWeight}} kg</strong></p>

      <h3 class="section-title">{{localize "ASOIAF.Inventory.arms"}}</h3>
      <table class="items-table">
        <thead><tr><th></th><th>{{localize "ASOIAF.Common.name"}}</th><th>{{localize "ASOIAF.Common.quantity"}}</th><th>{{localize "ASOIAF.Inventory.weightShort"}}</th><th>{{localize "ASOIAF.Common.cost"}}</th><th></th></tr></thead>
        <tbody>
          {{#each arms}}
            <tr data-item-id="{{id}}">
              <td><a class="equip {{#if system.equipped}}on{{/if}}" data-action="itemToggle" data-tooltip="ASOIAF.Common.equipped"><i class="fa-solid fa-hand-fist"></i></a></td>
              <td class="item-name"><img src="{{img}}" alt=""> {{name}}</td>
              <td class="center"><input class="mini" type="number" min="0" data-item-field="system.quantity" value="{{system.quantity}}"></td>
              <td class="center">{{system.weight}}</td>
              <td>{{system.cost}}</td>
              <td class="controls"><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></td>
            </tr>
          {{else}}
            <tr><td colspan="6" class="hint">{{localize "ASOIAF.Inventory.empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>

      <h3 class="section-title">{{localize "ASOIAF.Gear.title"}}
        {{#if editable}}<a class="add" data-action="itemCreate" data-type="equipment"><i class="fa-solid fa-plus"></i></a>{{/if}}</h3>
      {{#each inventory}}
        <h4 class="inventory-group">{{label}}</h4>
        <table class="items-table">
          <tbody>
            {{#each items}}
              <tr data-item-id="{{id}}">
                <td><a class="equip {{#if system.equipped}}on{{/if}}" data-action="itemToggle" data-tooltip="ASOIAF.Common.carried"><i class="fa-solid fa-sack-dollar"></i></a></td>
                <td class="item-name"><img src="{{img}}" alt=""> {{name}}</td>
                <td class="center"><input class="mini" type="number" min="0" data-item-field="system.quantity" value="{{system.quantity}}"></td>
                <td class="center">{{system.weight}}</td>
                <td>{{system.cost}}</td>
                <td class="controls"><a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a></td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p class="hint">{{localize "ASOIAF.Inventory.empty"}}</p>
      {{/each}}

      <h3 class="section-title"><i class="fa-solid fa-flask"></i> {{localize "ASOIAF.Poison.title"}}</h3>
      <table class="items-table">
        <thead><tr><th>{{localize "ASOIAF.Common.name"}}</th><th>{{localize "ASOIAF.Poison.delivery"}}</th><th>{{localize "ASOIAF.Poison.virulence"}}</th><th>{{localize "ASOIAF.Common.quantity"}}</th><th>{{localize "ASOIAF.Common.cost"}}</th><th></th></tr></thead>
        <tbody>
          {{#each poisons}}
            <tr data-item-id="{{id}}">
              <td class="item-name"><img src="{{item.img}}" alt=""> {{item.name}}</td>
              <td>{{delivery}}</td>
              <td class="center">{{#if item.system.alcohol}}—{{else}}{{item.system.virulence}}{{/if}}</td>
              <td class="center"><input class="mini" type="number" min="0" data-item-field="system.quantity" value="{{item.system.quantity}}"></td>
              <td>{{item.system.cost}}</td>
              <td class="controls">
                {{#if @root.editable}}<a data-action="administer" data-tooltip="ASOIAF.Poison.administerHint"><i class="fa-solid fa-syringe"></i></a>{{/if}}
                <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a><a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
              </td>
            </tr>
          {{else}}
            <tr><td colspan="6" class="hint">{{localize "ASOIAF.Poison.none"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    {{!-- Biographie --}}
    <div class="tab-panel {{#if (asEq activeTab 'bio')}}active{{/if}}" data-tab="bio">
      <div class="bio-grid">
        <label>{{localize "ASOIAF.Bio.concept"}}<input type="text" name="system.details.concept" value="{{system.details.concept}}"></label>
        <label>{{localize "ASOIAF.Bio.goal"}}<input type="text" name="system.details.goal" value="{{system.details.goal}}"></label>
        <label>{{localize "ASOIAF.Bio.motivation"}}<input type="text" name="system.details.motivation" value="{{system.details.motivation}}"></label>
        <label>{{localize "ASOIAF.Bio.virtue"}}<input type="text" name="system.details.virtue" value="{{system.details.virtue}}"></label>
        <label>{{localize "ASOIAF.Bio.vice"}}<input type="text" name="system.details.vice" value="{{system.details.vice}}"></label>
      </div>
      <label class="block">{{localize "ASOIAF.Bio.background"}}<textarea name="system.details.background" rows="5">{{system.details.background}}</textarea></label>
      <label class="block">{{localize "ASOIAF.Bio.appearance"}}<textarea name="system.details.appearance" rows="3">{{system.details.appearance}}</textarea></label>
      <label class="block">{{localize "ASOIAF.Bio.notes"}}<textarea name="system.details.notes" rows="6">{{system.details.notes}}</textarea></label>
    </div>
  </section>
</div>
